{
  "name": "expense-tracker-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/expense-tracker-client/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["expense_tracker_api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/expense-tracker-client"],
      "options": {
        "command": "tsc -p libs/expense-tracker-client/tsconfig.lib.json --outDir dist/libs/expense-tracker-client --rootDir libs/expense-tracker-client && cp libs/expense-tracker-client/package.json dist/libs/expense-tracker-client/"
      }
    },
    "orval": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "orval --config libs/expense-tracker-client/orval.config.js"
          }
        ]
      }
    }
  }
}
